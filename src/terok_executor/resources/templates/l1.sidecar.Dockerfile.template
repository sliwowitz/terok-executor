# syntax=docker/dockerfile:1
# L1 sidecar — lightweight tool container built FROM L0.
# No agent CLIs, no LLMs — just the specified tool binary and git.
# Shares L0's cached layers (git, SSH, locale, dev user, init scripts).
ARG BASE_IMAGE=terok-l0:latest
FROM ${BASE_IMAGE}

{% if family == "deb" %}ENV DEBIAN_FRONTEND=noninteractive
{% endif %}USER root

# Minimal extras for tool install scripts.
# L0 already provides: git, SSH, curl, ca-certificates, locale, dev user,
# init-ssh-and-repo.sh.
{% if family == "deb" -%}
RUN apt-get update && apt-get install -y --no-install-recommends \
      unzip \
    && rm -rf /var/lib/apt/lists/*
{%- else -%}
RUN dnf install -y --setopt=install_weak_deps=False unzip \
    && dnf clean all
{%- endif %}

ARG TOOL_CACHE_BUST=0

{% if tool_name == "coderabbit" %}
# CodeRabbit CLI — local AI code review (single-binary Node.js SEA).
# Installed to /usr/local/bin via the official installer script.
# Needs CODERABBIT_API_KEY at runtime (injected directly, not via proxy).
RUN set -eux; \
    CODERABBIT_INSTALL_DIR=/usr/local/bin \
    curl -fsSL https://cli.coderabbit.ai/install.sh | sh; \
    coderabbit --version
{% endif %}

# Socat bridges (SSH signer, vault, gate).  They ship with terok-sandbox rather
# than with executor, which is why they live here instead of in L0: an L1
# rebuild is the cadence at which a sandbox upgrade should reach running tasks.
COPY scripts/ssh-agent-bridge.sh /usr/local/bin/ssh-agent-bridge.sh
COPY scripts/ensure-bridges.sh /usr/local/bin/ensure-bridges.sh
RUN chmod +x /usr/local/bin/ssh-agent-bridge.sh /usr/local/bin/ensure-bridges.sh

USER dev
ENV HOME=/home/dev
WORKDIR /workspace
# No CMD: reuse init-ssh-and-repo.sh from L0 base image
